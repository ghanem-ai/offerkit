# --- Required ---
DATABASE_URL=postgres://offerkit:dev@localhost:5432/offerkit

# Background jobs use Redis/BullMQ. Required by web producers and worker consumers.
REDIS_URL=redis://localhost:6379

# 32+ char secret used by Better Auth to sign sessions
BETTER_AUTH_SECRET=please-change-this-32-chars-min-secret

# 32+ character key used to encrypt webhook signing secrets at rest.
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=please-change-this-webhook-encryption-key

# Public origin where the app is reachable (used for cookies, callbacks, OpenAPI server)
OFFERKIT_PUBLIC_URL=http://localhost:3000

# --- First-boot admin seed (only required on an empty database) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# --- Optional ---
# If set, transactional email (password reset, user invites) goes through Resend.
# If unset, emails are logged to stdout — perfect for local dev.
# RESEND_API_KEY=
# RESEND_FROM=Offerkit <onboarding@resend.dev>

# --- Observability (OpenTelemetry → any OTLP-compatible backend, e.g. Axiom) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <AXIOM_API_TOKEN>,X-Axiom-Dataset=offerkit
# OTEL_SDK_DISABLED=false

# --- SAML single sign-on (Authentik) ---
# SAML_ENABLED=true
# SAML_PROVIDER_ID=authentik
# SAML_IDP_SSO_URL=https://auth.internal.ghanem.dev/application/saml/offerkit/sso/binding/redirect/
# SAML_IDP_ENTITY_ID=https://auth.internal.ghanem.dev/application/saml/offerkit/metadata/
# SAML_IDP_CERTIFICATE=
# SAML_SP_ENTITY_ID=
# Email domain Better Auth uses to find this SSO provider.
# SAML_EMAIL_DOMAIN=ghanem.sa
# Group claim used to grant the admin role; everyone else is provisioned as a member.
# SAML_GROUPS_ATTRIBUTE=http://schemas.xmlsoap.org/claims/Group
# SAML_ADMIN_GROUP=platform-admins
# IdP-initiated sign-in bypasses InResponseTo replay protection. Leave off unless required.
# SAML_ALLOW_IDP_INITIATED=false

# --- Retention ---
# Days of `voucher.validation_failed` events kept by the recurring events.prune job.
# EVENT_RETENTION_DAYS=30

# --- Worker tuning ---
# WORKER_HEALTH_PORT=9091
# Optional readiness endpoint the web /ready probe reports on (informational only).
# If unset, checks.worker is null and no worker URL is guessed.
# WORKER_READINESS_URL=http://offerkit-worker:9091/ready
